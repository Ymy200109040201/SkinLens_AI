# ============================================================
# SkinLens AI 环境变量示例
#
# 本地：复制为 .env.local 后按需填写
# 公网：在部署平台（推荐 Vercel）的 Environment Variables 里逐条填写
#
# 全部留空也能正常运行：应用会自动进入「本地演示分析模式（Mock AI Mode）」，
# 用本地成分数据库 + 规则引擎生成结构完全一致的分析结果。
#
# 安全提醒：
# - 不要加 NEXT_PUBLIC_ 前缀，加了会被打包进浏览器代码。
# - 不要把真实 Key 写进任何前端文件，也不要提交 .env.local。
# ============================================================

# ---- AI 服务（可选；不填 = 使用本地演示模式）----
OPENAI_API_KEY=

# 使用的模型名称，可换成任意 OpenAI 兼容模型
AI_MODEL=gpt-4o-mini

# OpenAI 兼容网关地址（使用代理或兼容服务时修改；末尾不要带 /）
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- 演示模式开关（推荐公网 Demo 先打开）----
# 设为 true / 1 时强制使用本地演示模式，即使配置了 API Key 也不会调用外部 AI。
# 作用：公网 URL 谁都能访问，先用演示模式上线，确认流程没问题再填 Key 更省钱。
MOCK_AI=true

# 兼容的历史写法，等价于 MOCK_AI=1（两者任一为真即生效）
SKINLENS_FORCE_MOCK=0

# ---- 防刷限流（可选，单位：次 / 分钟 / 每个来源 IP）----
# 不填时：调用真实 AI 模型为 20 次/分钟，本地演示模式为 90 次/分钟。
# AI_RATE_LIMIT_PER_MINUTE=20
